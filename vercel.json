{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/playlist/sync", "destination": "/api/playlist" },
    { "source": "/api/playlist/events", "destination": "/api/playlist" },
    { "source": "/api/analytics/heartbeat", "destination": "/api/analytics" },
    { "source": "/api/analytics/leave", "destination": "/api/analytics" },
    { "source": "/api/analytics/stats", "destination": "/api/analytics" },
    { "source": "/api/artwork", "destination": "/api/artwork" },
    { "source": "/api/stream", "destination": "/api/stream" }
  ]
}
